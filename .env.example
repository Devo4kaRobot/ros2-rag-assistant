# Скопируй в .env и заполни (файл .env в git НЕ попадает)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: python src/rag/check_env.py подскажет, какие доступны твоему ключу
GIGACHAT_MODEL=
TELEGRAM_BOT_TOKEN=
# Необязательно: если Telegram открывается только через VPN-прокси
# TELEGRAM_PROXY=http://127.0.0.1:10801
